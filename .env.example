# Google Gemini API Key (Optionnelle pour le mode déterministe, requise pour les tests d'IA en direct)
GEMINI_API_KEY=

# Base de données PostgreSQL managée (ex: Railway Postgres, Supabase)
DATABASE_URL=

# Webhook d'alerte instantanée pour chaque lead (Slack ou Discord)
SLACK_WEBHOOK_URL=

# Origines CORS autorisées (Optionnel, défaut "*" sans credentials. Format CSV : "https://agentready.io,http://localhost:3000")
CORS_ORIGINS=

# Port d'écoute (injecté automatiquement par Railway / Render, défaut 8000 en local)
PORT=8000

# Rate Limiting anti-abus en mémoire (fenêtre glissante par IP)
# /api/scan : scans par fenêtre (défaut : 10 requêtes / 60 secondes)
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_SECONDS=60

# /api/gemini/simulate-question : requêtes LLM par fenêtre (défaut : 5 requêtes / 60 secondes)
SIM_RATE_LIMIT=5
SIM_RATE_WINDOW_SECONDS=60

# Garde-fous du scanner /api/scan (TACHE-02)
# Timeout réseau (s) du fetch de la page principale (clamp 1..60, défaut 12)
SCAN_FETCH_TIMEOUT_SECONDS=12
# Taille max (octets) d'une page principale analysée (clamp >=100000, défaut 2000000 = 2 Mo)
SCAN_MAX_RESPONSE_BYTES=2000000

# Anti-bot / coût CPU (P1-Sécurité)
# /api/lead : captures par fenêtre (défaut 20 / 60s)
LEAD_RATE_LIMIT=20
LEAD_RATE_WINDOW_SECONDS=60
# /api/report/pdf : générations PDF par fenêtre (défaut 10 / 60s)
REPORT_RATE_LIMIT=10
REPORT_RATE_WINDOW_SECONDS=60
