# Google Gemini API Key (Optionnelle pour le mode déterministe, requise pour les tests d'IA en direct)
GEMINI_API_KEY=

# Base de données PostgreSQL managée (ex: Railway Postgres, Supabase)
DATABASE_URL=

# Secret HMAC pour signer les tokens du tableau de bord client (/api/dashboard/*).
# OBLIGATOIRE en production : sans lui, le dashboard répond 503 (plus aucun défaut en dur).
# Générez-en un :  python -c "import secrets; print(secrets.token_hex(32))"
DASH_SECRET=

# Webhook d'alerte instantanée pour chaque lead (Slack ou Discord)
SLACK_WEBHOOK_URL=

# Email transactionnel Resend : notification fondateur à chaque lead capturé
# (résilient : un échec d'envoi n'est jamais bloquant pour l'utilisateur)
RESEND_API_KEY=
RESEND_FROM=AgentReady <audit@8dev.net>
RESEND_NOTIFY_TO=

# Origines CORS autorisées (Optionnel, défaut "*" sans credentials. Format CSV : "https://agentready.io,http://localhost:3000")
CORS_ORIGINS=

# Port d'écoute (injecté automatiquement par Railway / Render, défaut 8000 en local)
PORT=8000

# Rate Limiting anti-abus en mémoire (fenêtre glissante par IP)
# /api/scan : scans par fenêtre (défaut : 10 requêtes / 60 secondes)
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_SECONDS=60

# /api/gemini/simulate-question : requêtes LLM par fenêtre (défaut : 5 requêtes / 60 secondes)
SIM_RATE_LIMIT=5
SIM_RATE_WINDOW_SECONDS=60

# Garde-fous du scanner /api/scan (TACHE-02)
# Timeout réseau (s) du fetch de la page principale (clamp 1..60, défaut 12)
SCAN_FETCH_TIMEOUT_SECONDS=12
# Taille max (octets) d'une page principale analysée (clamp >=100000, défaut 2000000 = 2 Mo)
SCAN_MAX_RESPONSE_BYTES=2000000

# Anti-bot / coût CPU (P1-Sécurité)
# /api/lead : captures par fenêtre (défaut 20 / 60s)
LEAD_RATE_LIMIT=20
LEAD_RATE_WINDOW_SECONDS=60
# /api/report/pdf : générations PDF par fenêtre (défaut 10 / 60s)
REPORT_RATE_LIMIT=10
REPORT_RATE_WINDOW_SECONDS=60

# Sécurité des reverse-proxys et détection d'IP client (anti-usurpation X-Forwarded-For)
# Si activé ("true"), fait confiance aux en-têtes X-Forwarded-For envoyés au serveur.
# Auto-activé par défaut si déployé sur Railway, Render, Fly.io ou Heroku.
TRUST_PROXY_HEADERS=
# Liste des IP/hôtes de connexion directe de confiance autorisés à fournir X-Forwarded-For
# (Défaut : "127.0.0.1,::1,testclient,localhost")
TRUSTED_PROXIES=

# ============================================================================
# Stripe (paiements) — OBLIGATOIRE pour encaisser
# ============================================================================
# Clé secrète LIVE (commence par sk_live_...). Jamais la clé publishable ici.
STRIPE_LIVE_SECRET_KEY=
# Configuration du Customer Portal (gestion d'abonnement / carte / annulation)
STRIPE_PORTAL_CONFIG_ID=
# URL publique de l'app (retour du portail Stripe après gestion)
BASE_URL=

# Jeton secret protégeant les endpoints cron
# (/api/process-email-sequence, /api/process-payment-welcome). Génère : python -c "import secrets; print(secrets.token_hex(32))"
CRON_TOKEN=

# Quota de scans gratuits par email/IP avant up-sell (défaut : 5) — mensuel
FREE_SCAN_LIMIT=
# Quota mensuel de scans des abonnés Pro 49€ (défaut : 250)
PRO_SCAN_LIMIT=
# Quota mensuel de scans des abonnés Agency 199€ (défaut : 2500)
AGENCY_SCAN_LIMIT=
# Taille max (octets) d'une image proxifiée /api/proxy-image (défaut : 8 Mo)
PROXY_MAX_IMAGE_BYTES=
