# Google Gemini API Key (Optionnelle pour le mode déterministe, requise pour les tests d'IA en direct)
GEMINI_API_KEY=

# Base de données PostgreSQL managée (ex: Railway Postgres, Supabase)
DATABASE_URL=

# Webhook d'alerte instantanée pour chaque lead (Slack ou Discord)
SLACK_WEBHOOK_URL=

# Port d'écoute (injecté automatiquement par Railway / Render, défaut 8000 en local)
PORT=8000
